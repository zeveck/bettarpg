{
  "area": 0, "name": "New Game+: from a finished slot into slot 2 from the title, tougher fish, then the NG+1 Gar befriended at Level 13",
  "completes": "garFriend",
  "policy": "gar-party",
  "timeLimit": 420,
  "steps": [
    { "start": 0 },
    { "seed": 707 },
    { "set": { "endingsSeen": { "fins": true }, "lastEnding": "fins", "level": 10 } },
    { "js": "g.save(); sessionStorage.setItem('slot1', localStorage.getItem('bettarpg-save-1'));" },
    { "reload": true },
    { "check": "g.buttons().map((b) => b.label).join('|').startsWith('Continue|New Game+|New Game|Load')" },
    { "key": "ArrowDown", "after": 200 },
    { "key": "Enter", "after": 600 },
    { "check": "s.menus.includes('slots') && document.querySelector('.screen:not([hidden]) .btn.focus').textContent === 'Start here' && document.querySelector('.screen:not([hidden]) .btn.focus').closest('.slotrow') === document.querySelectorAll('#slotList .slotrow')[1]" },
    { "key": "Enter", "after": 500 },
    { "check": "s.menus.includes('confirm') && document.querySelector('#confirmText').textContent.includes('Every fish is 4 levels tougher')" },
    { "key": "ArrowRight", "after": 150 },
    { "key": "Enter", "after": 3500 },
    { "say": true },
    { "check": "s.slot === 2 && s.ngPlus === 1 && s.level === 10 && s.rest === 'village' && s.area === 'village' && Object.keys(s.flags).filter((k) => !['tutorialDone', 'metFinn'].includes(k)).length === 0 && s.flags.tutorialDone && s.friendsTotal === 0 && s.lastEnding === 'fins' && s.endingsSeen.fins" },
    { "check": "localStorage.getItem('bettarpg-save-1') === sessionStorage.getItem('slot1') && g.slots()[0].level === 10 && g.slots()[0].ngPlus === 0 && g.slots()[1].ngPlus === 1" },
    { "check": "document.querySelector('#hudLv').textContent === 'Lv 10+'" },
    { "js": "await g.goToLevel(1, { ngPlus: 1 });", "after": 1200 },
    { "check": "s.enemies.filter((e) => e.kind === 'guppy').length > 0 && s.enemies.filter((e) => e.kind === 'guppy').every((e) => e.level >= 5 && e.level <= 6) && s.enemies.filter((e) => e.edge).every((e) => e.level === 14)" },
    { "js": "await g.goToLevel(5, { ngPlus: 1 });", "after": 1200 },
    { "set": { "level": 13, "friends": { "angel": 2, "guppy": 2, "cat": 1 }, "items": { "bwater": 2 } } },
    { "path": [[560, 110], [630, 112]], "note": "Gate Spring" },
    { "path": [[560, 300], [560, 430], [612, 430]], "note": "at the Gar" },
    { "battle": "gar-party" },
    { "say": true },
    { "expect": { "garFriend": true } },
    { "check": "s.lastEnding === 'friend' && s.ending === 'fins' && s.ngPlus === 1" }
  ]
}
